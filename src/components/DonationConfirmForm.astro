<div class="relative">
  <div class="absolute inset-0 z-10 bg-white/80 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center p-8">
    <span class="px-4 py-1.5 bg-amber-100 text-amber-700 text-sm font-bold rounded-full mb-4">
      🚧 Form Sedang Dalam Pengembangan
    </span>
    <p class="text-text-muted text-center mb-6 max-w-md">
      Konfirmasi donasi sementara dilakukan manual melalui WhatsApp. Silakan hubungi kami untuk konfirmasi.
    </p>
    <a
      href="https://wa.me/6282254500939?text=Assalamu%27alaikum%2C%20saya%20ingin%20konfirmasi%20donasi..."
      target="_blank"
      rel="noopener"
      class="px-8 py-4 bg-green-600 text-white rounded-xl font-bold text-lg hover:bg-green-700 transition-colors flex items-center gap-2"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Konfirmasi via WhatsApp
    </a>
  </div>

  <!-- Disabled form (structure ready for future activation) -->
  <div class="opacity-40 pointer-events-none">
    <div class="bg-white rounded-2xl border border-border p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-text mb-1">Nama Donatur</label>
        <input type="text" class="w-full px-4 py-2.5 rounded-xl border border-border bg-bg-alt text-text" placeholder="Nama lengkap" disabled />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Nominal Donasi</label>
          <input type="text" class="w-full px-4 py-2.5 rounded-xl border border-border bg-bg-alt text-text" placeholder="Rp 0" disabled />
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tanggal Transfer</label>
          <input type="date" class="w-full px-4 py-2.5 rounded-xl border border-border bg-bg-alt text-text" disabled />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-1">Metode Pembayaran</label>
        <select class="w-full px-4 py-2.5 rounded-xl border border-border bg-bg-alt text-text" disabled>
          <option>Pilih metode</option>
          <option>Transfer Bank</option>
          <option>E-Wallet</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-1">Upload Bukti Transfer</label>
        <input type="file" class="w-full px-4 py-2.5 rounded-xl border border-border bg-bg-alt text-text" disabled />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-1">Catatan</label>
        <textarea class="w-full px-4 py-2.5 rounded-xl border border-border bg-bg-alt text-text" rows="3" placeholder="Catatan opsional" disabled></textarea>
      </div>
      <button type="button" class="w-full py-3 bg-primary/50 text-white rounded-xl font-semibold cursor-not-allowed" disabled>
        Kirim Konfirmasi
      </button>
    </div>
  </div>
</div>
