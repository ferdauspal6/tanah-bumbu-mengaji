---
interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const allImages = Array.from({ length: 35 }, (_, i) => ({
  id: i + 1,
  src: `/images/dokumentasi/Dokumentaso_${i + 1}.jpeg`,
  alt: `Dokumentasi kegiatan ${i + 1}`,
}));

const images = limit ? allImages.slice(-limit).reverse() : allImages.reverse();
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" x-data="{ lightbox: null }">
  {images.map((img) => (
    <button
      type="button"
      class="aspect-square rounded-xl overflow-hidden border border-border hover:shadow-md transition-shadow cursor-pointer group"
      x-on:click={`lightbox = '${img.src}'`}
    >
      <img
        src={img.src}
        alt={img.alt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </button>
  ))}

  <!-- Lightbox modal -->
  <template x-if="lightbox">
    <div
      class="fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4"
      x-on:click="lightbox = null"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
    >
      <div class="relative max-w-4xl w-full" x-on:click.stop>
        <img
          :src="lightbox"
          alt="Dokumentasi"
          class="w-full h-auto max-h-[85vh] object-contain rounded-lg"
        />
        <button
          type="button"
          class="absolute top-2 right-2 w-10 h-10 bg-black/50 text-white rounded-full flex items-center justify-center hover:bg-black/70 transition-colors"
          x-on:click="lightbox = null"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </template>
</div>
