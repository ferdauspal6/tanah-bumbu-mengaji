---
interface Props {
  imageIds?: number[];
  showAll?: boolean;
}

const { imageIds, showAll = false } = Astro.props;

const allImages = Array.from({ length: 35 }, (_, i) => ({
  id: i + 1,
  src: `/images/dokumentasi/Dokumentaso_${i + 1}.jpeg`,
  alt: `Dokumentasi kegiatan ${i + 1}`,
}));

const images = imageIds
  ? imageIds.map(id => allImages.find(img => img.id === id)).filter(Boolean)
  : showAll
    ? [...allImages].reverse()
    : allImages;

const imagesJson = JSON.stringify(images);
---

<div
  class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"
  x-data={`{
    open: false,
    index: 0,
    images: ${imagesJson},
    direction: 'none',
    show(i) {
      this.direction = i > this.index ? 'next' : 'prev';
      this.index = i;
      this.open = true;
      document.body.classList.add('lg-overflow-hidden');
      this.$nextTick(() => this.setupKeyboard());
    },
    close() {
      this.open = false;
      document.body.classList.remove('lg-overflow-hidden');
      document.removeEventListener('keydown', this._keydownHandler);
    },
    next() {
      this.direction = 'next';
      this.index = (this.index + 1) % this.images.length;
    },
    prev() {
      this.direction = 'prev';
      this.index = (this.index - 1 + this.images.length) % this.images.length;
    },
    goTo(i) {
      this.direction = i > this.index ? 'next' : 'prev';
      this.index = i;
    },
    get src() { return this.images[this.index]?.src; },
    get alt() { return this.images[this.index]?.alt; },
    get total() { return this.images.length; },
    setupKeyboard() {
      this._keydownHandler = (e) => {
        if (e.key === 'Escape') this.close();
        if (e.key === 'ArrowRight') this.next();
        if (e.key === 'ArrowLeft') this.prev();
      };
      document.addEventListener('keydown', this._keydownHandler);
    }
  }`}
>
  {images.map((img, i) => (
    <button
      type="button"
      class="aspect-square rounded-xl overflow-hidden border border-border hover:shadow-md transition-shadow cursor-pointer group"
      x-on:click={`show(${i})`}
    >
      <img
        src={img.src}
        alt={img.alt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </button>
  ))}

  <!-- Lightbox Overlay -->
  <template x-if="open">
    <div
      class="fixed inset-0 z-50 bg-black/95 lg-fade-in flex flex-col"
      x-on:click.self="close()"
    >
      <!-- Top bar -->
      <div class="flex items-center justify-between px-4 py-3 shrink-0">
        <span class="text-white/70 text-sm font-medium" x-text="index + 1 + ' / ' + total"></span>
        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors text-white/80 hover:text-white"
          x-on:click="close()"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Main image area -->
      <div class="flex-1 flex items-center justify-center min-h-0 relative px-16">
        <!-- Prev button -->
        <button
          type="button"
          class="absolute left-2 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-black/40 text-white/80 hover:bg-black/60 hover:text-white transition-all backdrop-blur-sm z-10"
          x-on:click.stop="prev()"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <!-- Image with slide transition -->
        <div class="w-full h-full flex items-center justify-center">
          <img
            :src="src"
            :alt="alt"
            class="max-w-full max-h-full object-contain lg-slide-in select-none"
          />
        </div>

        <!-- Next button -->
        <button
          type="button"
          class="absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-black/40 text-white/80 hover:bg-black/60 hover:text-white transition-all backdrop-blur-sm z-10"
          x-on:click.stop="next()"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <!-- Thumbnail strip -->
      <div class="shrink-0 px-4 py-3 bg-black/60 backdrop-blur-sm">
        <div class="flex gap-2 justify-center overflow-x-auto pb-1 max-w-5xl mx-auto scrollbar-hide" x-ref="thumbStrip">
          <template x-for="(img, i) in images" :key="i">
            <button
              type="button"
              class="shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-lg overflow-hidden border-2 transition-all duration-200"
              x-bind:class="i === index ? 'border-white opacity-100 scale-105' : 'border-transparent opacity-50 hover:opacity-80'"
              x-on:click="goTo(i)"
            >
              <img :src="img.src" :alt="img.alt" class="w-full h-full object-cover" />
            </button>
          </template>
        </div>
      </div>
    </div>
  </template>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
