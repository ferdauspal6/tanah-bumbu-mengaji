---
interface Props {
  imageIds?: number[];
  showAll?: boolean;
}

const { imageIds, showAll = false } = Astro.props;

const allImages = Array.from({ length: 35 }, (_, i) => ({
  id: i + 1,
  src: `/images/dokumentasi/Dokumentaso_${i + 1}.jpeg`,
  alt: `Dokumentasi kegiatan ${i + 1}`,
}));

const images = imageIds
  ? imageIds.map(id => allImages.find(img => img.id === id)).filter(Boolean)
  : showAll
    ? [...allImages].reverse()
    : allImages;
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" x-data="{ lightbox: null }">
  {images.map((img) => (
    <button
      type="button"
      class="aspect-square rounded-xl overflow-hidden border border-border hover:shadow-md transition-shadow cursor-pointer group"
      x-on:click={`lightbox = '${img.src}'`}
    >
      <img
        src={img.src}
        alt={img.alt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </button>
  ))}

  <!-- Lightbox modal -->
  <template x-if="lightbox">
    <div
      class="fixed inset-0 z-50 bg-black/95 flex items-center justify-center"
      x-on:click="lightbox = null"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
    >
      <img
        :src="lightbox"
        alt="Dokumentasi"
        class="max-w-full max-h-full object-contain"
      />
      <button
        type="button"
        class="absolute top-4 right-4 w-12 h-12 bg-white/10 text-white rounded-full flex items-center justify-center hover:bg-white/20 transition-colors backdrop-blur-sm"
        x-on:click="lightbox = null"
      >
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </template>
</div>
