---
---

<form class="space-y-4" x-data="{ submitted: false, loading: false }" x-on:submit.prevent="loading = true; setTimeout(() => { submitted = true; loading = false; }, 1500)">
  <div>
    <label for="nama" class="block text-sm font-medium text-text mb-1">Nama</label>
    <input
      type="text"
      id="nama"
      name="nama"
      required
      class="w-full px-4 py-2.5 rounded-xl border border-border bg-white text-text focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors"
      placeholder="Nama lengkap"
    />
  </div>
  <div>
    <label for="kontak" class="block text-sm font-medium text-text mb-1">Email / No HP</label>
    <input
      type="text"
      id="kontak"
      name="kontak"
      required
      class="w-full px-4 py-2.5 rounded-xl border border-border bg-white text-text focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors"
      placeholder="email@contoh.com atau 08xxx"
    />
  </div>
  <div>
    <label for="pesan" class="block text-sm font-medium text-text mb-1">Pesan</label>
    <textarea
      id="pesan"
      name="pesan"
      required
      rows="4"
      class="w-full px-4 py-2.5 rounded-xl border border-border bg-white text-text focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors resize-none"
      placeholder="Tulis pesan Anda..."
    ></textarea>
  </div>

  <template x-if="!submitted">
    <button
      type="submit"
      class="w-full py-3 bg-primary text-white rounded-xl font-semibold hover:bg-primary-dark transition-colors flex items-center justify-center gap-2"
      :disabled="loading"
    >
      <svg x-show="loading" class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
      <span x-text="loading ? 'Mengirim...' : 'Kirim Pesan'"></span>
    </button>
  </template>

  <template x-if="submitted">
    <div class="p-4 bg-green-50 text-green-700 rounded-xl text-center font-medium">
      Terima kasih! Pesan Anda telah terkirim.
    </div>
  </template>
</form>
