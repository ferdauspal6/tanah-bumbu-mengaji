---
interface Props {
  platform: string;
  url: string;
  icon: string;
}

const { platform, url, icon } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="block bg-white rounded-2xl border border-border p-6 hover:shadow-md transition-shadow text-center group"
>
  <div class="w-12 h-12 mx-auto mb-3 bg-primary/10 rounded-xl flex items-center justify-center group-hover:bg-primary/20 transition-colors">
    <Fragment set:html={icon} />
  </div>
  <h3 class="font-semibold text-text mb-2">{platform}</h3>
  <span class="text-sm text-primary font-medium">Follow &rarr;</span>
</a>
