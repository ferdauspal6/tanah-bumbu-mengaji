---
interface Props {
  nama: string;
  jabatan: string;
  foto: string;
  featured?: boolean;
}

const { nama, jabatan, foto, featured = false } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-border overflow-hidden hover:shadow-md transition-shadow ${featured ? 'md:col-span-2 lg:col-span-3' : ''}`}>
  <div class={`bg-gradient-to-br from-primary/20 to-accent-gold/20 flex items-center justify-center ${featured ? 'aspect-[2/1] md:aspect-[3/1]' : 'aspect-square'}`}>
    <div class="text-center p-4">
      <svg class="w-16 h-16 mx-auto mb-2 text-text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span class="text-xs text-text-muted/60">Placeholder: {nama}</span>
    </div>
  </div>
  <div class="p-4 text-center">
    <h3 class={`font-bold font-heading text-text ${featured ? 'text-xl' : 'text-base'}`}>{nama}</h3>
    <p class="text-sm text-primary font-medium mt-1">{jabatan}</p>
  </div>
</div>
