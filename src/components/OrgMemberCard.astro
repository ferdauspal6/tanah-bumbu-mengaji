---
interface Props {
  nama: string;
  jabatan: string;
  featured?: boolean;
}

const { nama, jabatan, featured = false } = Astro.props;
---

<div class={`flex flex-col items-center ${featured ? '' : ''}`}>
  <div class={`rounded-full bg-primary flex items-center justify-center ${featured ? 'w-24 h-24' : 'w-20 h-20'}`}>
    <svg class={`text-white ${featured ? 'w-12 h-12' : 'w-10 h-10'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
    </svg>
  </div>
  <h3 class={`font-bold font-heading text-text mt-3 text-center ${featured ? 'text-lg' : 'text-sm'}`}>{nama}</h3>
  <p class="text-xs text-primary font-medium mt-0.5">{jabatan}</p>
</div>
