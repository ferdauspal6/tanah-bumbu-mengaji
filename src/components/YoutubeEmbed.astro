---
interface Props {
  videoId: string;
  title?: string;
}

const { videoId, title = 'Video Dakwah' } = Astro.props;
---

<div class="aspect-video rounded-2xl overflow-hidden bg-text/5 border border-border">
  <iframe
    src={`https://www.youtube.com/embed/${videoId}`}
    title={title}
    class="w-full h-full"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    loading="lazy"
  ></iframe>
</div>
