---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import PosterFeed from '../components/PosterFeed.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import SocialCard from '../components/SocialCard.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Beranda" description="Media dakwah sunnah di Tanah Bumbu, Kalimantan Selatan. Menebar ilmu, mempererat ukhuwah.">
  <Navbar />

  <!-- Hero -->
  <Hero
    pretitle="Media Dakwah Sunnah"
    headline="Tanah Bumbu Mengaji"
    description="Media Dakwah dan Informasi Islam Berlandaskan Al-Qur'an dan Sunnah, Mengajak kepada Kebaikan dan Menebarkan Ilmu di Tanah Bumbu."
    ctaPrimary={{ label: 'Lihat Jadwal Kajian', href: '#kegiatan' }}
    ctaSecondary={{ label: 'Donasi Sekarang', href: '/donasi' }}
  />

  <!-- Tentang Singkat -->
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="animate-on-scroll">
        <SectionHeading title="Tentang Kami" subtitle="Menebar dakwah sunnah dengan penuh keikhlasan di Tanah Bumbu" />
      </div>
      <div class="max-w-3xl mx-auto text-center mb-12 animate-on-scroll delay-1">
        <p class="text-text-muted leading-relaxed">
          Tanah Bumbu Mengaji adalah komunitas dakwah yang berkomitmen untuk menyebarkan dakwah sunnah di Tanah Bumbu, Kalimantan Selatan. Kami mengadakan kajian rutin, dokumentasi kegiatan, dan penggalangan dana untuk operasional dakwah.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl border border-border p-6 text-center hover:shadow-md transition-shadow animate-on-scroll delay-1">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary/10 rounded-xl flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-bold font-heading text-text mb-2">Livestreaming Kajian</h3>
          <p class="text-sm text-text-muted">Menyajikan kajian sunnah secara langsung melalui platform digital</p>
        </div>
        <div class="bg-white rounded-2xl border border-border p-6 text-center hover:shadow-md transition-shadow animate-on-scroll delay-2">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary/10 rounded-xl flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
          </div>
          <h3 class="font-bold font-heading text-text mb-2">Pusat Informasi Dakwah</h3>
          <p class="text-sm text-text-muted">Menyebarkan informasi dan materi dakwah yang bermanfaat</p>
        </div>
        <div class="bg-white rounded-2xl border border-border p-6 text-center hover:shadow-md transition-shadow animate-on-scroll delay-3">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary/10 rounded-xl flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="font-bold font-heading text-text mb-2">Komunitas Muslim</h3>
          <p class="text-sm text-text-muted">Mempererat ukhuwah dan silaturahmi sesama muslim</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Jadwal Kajian -->
  <section id="kegiatan" class="py-16 md:py-20 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="animate-on-scroll">
        <SectionHeading title="Jadwal Kajian & Livestream" subtitle="Ikuti kajian rutin kami secara langsung atau online" />
      </div>
      <div class="max-w-4xl mx-auto mb-8 animate-on-scroll delay-1">
        <div class="bg-white rounded-2xl border border-border overflow-hidden">
          <div class="px-6 py-3 bg-primary/5 border-b border-border flex items-center justify-between">
            <span class="text-sm font-semibold text-text">Jadwal Kajian</span>
            <span class="px-3 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">Fitur Dalam Pengembangan</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border">
                  <th class="px-6 py-3 text-left font-semibold text-text-muted">Hari</th>
                  <th class="px-6 py-3 text-left font-semibold text-text-muted">Waktu</th>
                  <th class="px-6 py-3 text-left font-semibold text-text-muted">Kajian</th>
                  <th class="px-6 py-3 text-left font-semibold text-text-muted">Lokasi</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-dashed border-border/60">
                  <td class="px-6 py-4 text-text-muted">Rabu</td>
                  <td class="px-6 py-4 text-text-muted">Ba'da Maghrib</td>
                  <td class="px-6 py-4 text-text-muted">Kajian Kitab Tauhid</td>
                  <td class="px-6 py-4 text-text-muted">Musholla Ibnu Abbas Kersik Putih</td>
                </tr>
                <tr class="border-b border-dashed border-border/60">
                  <td class="px-6 py-4 text-text-muted">Sabtu</td>
                  <td class="px-6 py-4 text-text-muted">Ba'da Maghrib</td>
                  <td class="px-6 py-4 text-text-muted">Kajian Tematik</td>
                  <td class="px-6 py-4 text-text-muted">Masjid Tarbiyatul Awlad Sungai Kecil</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-text-muted">Ahad</td>
                  <td class="px-6 py-4 text-text-muted">Ba'da Maghrib</td>
                  <td class="px-6 py-4 text-text-muted">Kajian Fiqih</td>
                  <td class="px-6 py-4 text-text-muted">Musholla Ibnu Abbas Kersik Putih</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="text-center animate-on-scroll delay-2">
        <a href="/kegiatan" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-xl font-semibold hover:bg-primary-dark transition-colors">
          Lihat Semua Kegiatan
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Galeri Kegiatan -->
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="animate-on-scroll">
        <SectionHeading title="Galeri Kegiatan" subtitle="Dokumentasi kegiatan dakwah Tanah Bumbu Mengaji" />
      </div>
      <div class="animate-on-scroll delay-1">
        <GalleryGrid imageIds={[30, 33, 35, 26, 22, 21, 14, 13, 9, 10, 8, 1]} />
      </div>
      <div class="text-center mt-8 animate-on-scroll delay-2">
        <a
          href="/kegiatan#dokumentasi"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-xl font-semibold hover:bg-primary-dark transition-colors"
        >
          Tampilkan Lebih Banyak
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Poster Harian -->
  <div class="animate-on-scroll">
    <PosterFeed />
  </div>

  <!-- Konten Dakwah -->
  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="animate-on-scroll">
        <SectionHeading title="Konten Dakwah" subtitle="Tonton kajian dan video dakwah terbaru kami" />
      </div>
      <div class="max-w-4xl mx-auto mb-8 animate-on-scroll delay-1">
        <YoutubeEmbed videoId="wl3Lr5eTo1Q" title="Kajian Terbaru" />
      </div>
      <div class="text-center animate-on-scroll delay-2">
        <a
          href="https://youtube.com/c/TanahBumbuMengaji"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 text-white rounded-xl font-semibold hover:bg-red-700 transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          Subscribe YouTube
        </a>
      </div>
    </div>
  </section>

  <!-- Sosial Media -->
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="animate-on-scroll">
        <SectionHeading title="Ikuti Kami" subtitle="Terhubung dengan kami di media sosial" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="animate-on-scroll delay-1">
          <SocialCard
            platform="Facebook"
            url="https://www.facebook.com/tanahbumbumengaji1/"
            icon='<svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>'
          />
        </div>
        <div class="animate-on-scroll delay-2">
          <SocialCard
            platform="Instagram"
            url="https://www.instagram.com/tanahbumbumengaji/"
            icon='<svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>'
          />
        </div>
        <div class="animate-on-scroll delay-3">
          <SocialCard
            platform="YouTube"
            url="https://youtube.com/c/TanahBumbuMengaji"
            icon='<svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Info Donasi Ringkas -->
  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="animate-on-scroll">
        <SectionHeading title="Dukung Dakwah Kami" subtitle="Setiap donasi Anda sangat berarti untuk kelangsungan dakwah sunnah di Tanah Bumbu" />
      </div>
      <div class="text-center animate-on-scroll delay-1">
        <a href="/donasi" class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark transition-colors">
          Donasi Sekarang
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Penutup -->
  <div class="animate-on-scroll">
    <CTASection
      headline="Bergabunglah Bersama Kami"
      description="Ikuti kajian, donasi, dan jadilah bagian dari dakwah sunnah di Tanah Bumbu."
      ctaLabel="Mulai Sekarang"
      ctaHref="/hubungi-kami"
    />
  </div>

  <Footer />
</BaseLayout>
