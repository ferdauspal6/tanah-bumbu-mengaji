---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import DonationInfoCard from '../components/DonationInfoCard.astro';
import DonationConfirmForm from '../components/DonationConfirmForm.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Donasi" description="Dukung dakwah sunnah di Tanah Bumbu melalui donasi Anda.">
  <Navbar />

  <Hero
    headline="Dukung Dakwah Sunnah di Tanah Bumbu"
    subheadline="Setiap donasi Anda sangat berarti untuk kelangsungan kegiatan dakwah kami."
    small
  />

  <!-- Rekening Donasi -->
  <section class="py-16 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Informasi Donasi</h2>
        <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto">Anda dapat berdonasi melalui rekening bank berikut</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto mb-12">
        <div class="animate-on-scroll delay-1"><DonationInfoCard judul="Donasi Media Dakwah" namaBank="BSI (Kode: 451)" nomorRekening="7300984449" namaPemilik="a.n Tanah Bumbu Mengaji" /></div>
        <div class="animate-on-scroll delay-2"><DonationInfoCard judul="Infaq KAIFA Rumah Belajar" namaBank="BSI" nomorRekening="7187087408" namaPemilik="a.n Yayasan Tambang Ilmu Hasah" /></div>
      </div>

      <!-- Form Konfirmasi -->
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Konfirmasi Donasi</h2>
          <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
        </div>
        <div class="animate-on-scroll delay-1"><DonationConfirmForm /></div>
      </div>
    </div>
  </section>

  <!-- Gabung Jadi Donatur Tetap -->
  <section class="py-16 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-white">Gabung Jadi Donatur Tetap</h2>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto leading-relaxed">
        Kami mengundang para ikhwah sekalian untuk menjadi donatur tetap media dakwah kami. Dengan menjadi donatur tetap, Anda membantu kami terus berkembang dan menyebarkan dakwah sunnah lebih luas lagi ke seluruh Tanah Bumbu.
      </p>
      <a
        href="https://chat.whatsapp.com/KdsLlpLm1c9AVoDqxk7OrB"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 mt-8 px-8 py-4 bg-white text-primary rounded-xl font-bold text-lg hover:bg-white/90 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Gabung Sekarang
      </a>
    </div>
  </section>

  <!-- FAQ Donasi -->
  <section class="py-16 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Pertanyaan Umum</h2>
        <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
      </div>

      <div class="space-y-4 animate-on-scroll delay-1" x-data="{ open: null }">
        <div class="bg-white rounded-2xl border border-border overflow-hidden">
          <button type="button" class="w-full px-6 py-4 text-left flex items-center justify-between font-semibold text-text" x-on:click="open = open === 1 ? null : 1">
            Bagaimana cara berdonasi?
            <svg class="w-5 h-5 text-text-muted transition-transform" :class="{ 'rotate-180': open === 1 }" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div x-show="open === 1" x-collapse>
            <div class="px-6 pb-4 text-text-muted">
              Pilih rekening bank atau e-wallet yang tersedia, lakukan transfer sesuai nominal yang diinginkan, dan konfirmasi melalui WhatsApp atau form konfirmasi di atas.
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-border overflow-hidden">
          <button type="button" class="w-full px-6 py-4 text-left flex items-center justify-between font-semibold text-text" x-on:click="open = open === 2 ? null : 2">
            Apakah donasi saya aman?
            <svg class="w-5 h-5 text-text-muted transition-transform" :class="{ 'rotate-180': open === 2 }" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div x-show="open === 2" x-collapse>
            <div class="px-6 pb-4 text-text-muted">
              Ya, kami menggunakan rekening resmi yang terdaftar atas nama organisasi. Semua donasi akan dipertanggungjawabkan dengan transparan.
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-border overflow-hidden">
          <button type="button" class="w-full px-6 py-4 text-left flex items-center justify-between font-semibold text-text" x-on:click="open = open === 3 ? null : 3">
            Bagaimana saya tahu donasi saya sudah sampai?
            <svg class="w-5 h-5 text-text-muted transition-transform" :class="{ 'rotate-180': open === 3 }" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div x-show="open === 3" x-collapse>
            <div class="px-6 pb-4 text-text-muted">
              Konfirmasi melalui WhatsApp atau form di atas. Kami akan memberikan kabar bahwa donasi Anda telah diterima dan akan digunakan untuk kepentingan dakwah.
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-border overflow-hidden">
          <button type="button" class="w-full px-6 py-4 text-left flex items-center justify-between font-semibold text-text" x-on:click="open = open === 4 ? null : 4">
            Bagaimana penggunaan dana donasi?
            <svg class="w-5 h-5 text-text-muted transition-transform" :class="{ 'rotate-180': open === 4 }" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div x-show="open === 4" x-collapse>
            <div class="px-6 pb-4 text-text-muted">
              Dana donasi digunakan untuk operasional kajian, sewa tempat, konsumsi, produksi konten dakwah, dan kegiatan sosial lainnya. Laporan pertanggungjawaban akan dipublikasikan secara berkala.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    headline="Jadilah Bagian dari Dakwah"
    description="Donasi Anda membantu kami terus menebar ilmu sunnah."
    ctaLabel="Kembali ke Beranda"
    ctaHref="/"
  />

  <Footer />
</BaseLayout>
