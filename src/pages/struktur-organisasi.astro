---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import OrgMemberCard from '../components/OrgMemberCard.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import { organisasiData } from '../data/organisasi';

const ketua = organisasiData.find(a => a.jabatan === 'Ketua');
const anggota = organisasiData.filter(a => a.jabatan !== 'Ketua');
---

<BaseLayout title="Struktur Organisasi" description="Kenali pengurus dan anggota Tanah Bumbu Mengaji.">
  <Navbar />

  <Hero
    headline="Struktur Organisasi"
    subheadline="Para pengurus yang berdedikasi untuk dakwah sunnah di Tanah Bumbu."
    small
  />

  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Ketua -->
      <div class="max-w-sm mx-auto mb-12">
        {ketua && <OrgMemberCard nama={ketua.nama} jabatan={ketua.jabatan} foto={ketua.foto} featured />}
      </div>

      <!-- Anggota -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {anggota.map((a) => (
          <OrgMemberCard nama={a.nama} jabatan={a.jabatan} foto={a.foto} />
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline="Bergabung Bersama Kami"
    description="Ingin menjadi bagian dari Tim Dakwah Tanah Bumbu Mengaji?"
    ctaLabel="Hubungi Kami"
    ctaHref="/hubungi-kami"
  />

  <Footer />
</BaseLayout>
