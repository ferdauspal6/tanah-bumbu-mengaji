---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import OrgMemberCard from '../components/OrgMemberCard.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import { organisasiData } from '../data/organisasi';

const ketua = organisasiData.find(a => a.jabatan === 'Ketua');
const anggota = organisasiData.filter(a => a.jabatan !== 'Ketua');
---

<BaseLayout title="Struktur Organisasi" description="Kenali pengurus dan anggota Tanah Bumbu Mengaji.">
  <Navbar />

  <Hero
    headline="Struktur Organisasi"
    subheadline="Para pengurus yang berdedikasi untuk dakwah sunnah di Tanah Bumbu."
    small
  />

  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative animate-on-scroll">
        <div class="flex justify-center mb-2">
          {ketua && <OrgMemberCard nama={ketua.nama} jabatan={ketua.jabatan} featured />}
        </div>

        <div class="flex justify-center">
          <div class="w-px h-8 bg-border"></div>
        </div>

        <div class="relative mx-auto" style="max-width: 90%;">
          <div class="absolute top-0 left-0 right-0 h-px bg-border"></div>

          <div class="flex justify-between px-0">
            {anggota.map((_, i) => (
              <div class="flex flex-col items-center">
                <div class="w-px h-8 bg-border"></div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 mt-0 max-w-4xl mx-auto animate-on-scroll delay-1">
          {anggota.map((a) => (
            <OrgMemberCard nama={a.nama} jabatan={a.jabatan} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection
    headline="Bergabung Bersama Kami"
    description="Ingin menjadi bagian dari Tim Dakwah Tanah Bumbu Mengaji?"
    ctaLabel="Hubungi Kami"
    ctaHref="/hubungi-kami"
  />

  <Footer />
</BaseLayout>
