---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import OrgMemberCard from '../components/OrgMemberCard.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import { pengurusData, kontributorData, yayasanData } from '../data/organisasi';

const ketua = pengurusData.find(p => p.jabatan === 'Ketua');
const pengurusLain = pengurusData.filter(p => p.jabatan !== 'Ketua');
const [ibnuAbbas, tambangIlmu] = yayasanData;
---

<BaseLayout title="Struktur Organisasi" description="Struktur, afiliasi yayasan, dan pengurus Tanah Bumbu Mengaji.">
  <Navbar />

  <Hero
    headline="Struktur Organisasi"
    description="Mengenal lebih dekat struktur, afiliasi yayasan, dan orang-orang di balik Tanah Bumbu Mengaji."
    small
  />

  <!-- INTRO -->
  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-on-scroll">
      <span class="inline-block px-3 py-1 bg-primary/5 text-primary text-xs font-semibold rounded-full uppercase tracking-wider">Afiliasi & Naungan</span>
      <p class="mt-6 text-text-muted leading-relaxed text-base md:text-lg">
        <strong class="text-text">Tanah Bumbu Mengaji</strong> berada di bawah
        <strong class="text-text">Yayasan Ibnu Abbas Tanah Bumbu</strong> dan berafiliasi dengan
        <strong class="text-text">Yayasan Tambang Ilmu Hasanah</strong>.
      </p>
    </div>
  </section>

  <!-- STRUKTUR AFILIASI YAYASAN -->
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Struktur Afiliasi Yayasan</h2>
        <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-6 md:gap-4 items-center animate-on-scroll delay-1">
        {yayasanData.map((y, i) => (
          <>
            <div class="bg-white rounded-2xl border border-border p-8 flex flex-col items-center text-center hover:shadow-md transition-shadow">
              <div class="h-28 w-28 flex items-center justify-center mb-5">
                <img src={y.logo} alt={y.nama} class="max-h-full max-w-full object-contain" />
              </div>
              <h3 class="font-bold font-heading text-text text-lg leading-snug">{y.nama}</h3>
            </div>

            {i === 0 && (
              <div class="flex flex-col items-center justify-center gap-2 py-2 md:py-0">
                <div class="w-px h-8 bg-border md:hidden"></div>
                <span class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center text-lg font-bold shrink-0">↕</span>
                <span class="text-xs font-semibold text-primary uppercase tracking-wider text-center max-w-[8rem]">Afiliasi / Berasosiasi</span>
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAM DI BAWAH YAYASAN -->
  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Program di Bawah Naungan</h2>
        <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto">Setiap yayasan menaungi program dakwah dan edukasi masing-masing.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {yayasanData.map((y, i) => (
          <div class={`bg-bg-alt rounded-2xl border border-border p-8 animate-on-scroll delay-${i + 1}`}>
            <p class="text-xs font-semibold text-primary uppercase tracking-wider">{y.nama}</p>
            <h3 class="mt-3 text-xl font-bold font-heading text-text">{y.program.nama}</h3>
            <p class="text-sm text-text-muted mt-1 italic">{y.program.deskripsi}</p>

            <div class="mt-6 pt-6 border-t border-border">
              <p class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">Program / Bagian</p>
              <ul class="space-y-2">
                {y.program.bagian.map((b) => (
                  <li class="flex items-center gap-3 text-sm text-text">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-gold shrink-0"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PENGURUS -->
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Pengurus</h2>
        <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
      </div>

      <div class="relative animate-on-scroll delay-1">
        <div class="flex justify-center mb-2">
          {ketua && <OrgMemberCard nama={ketua.nama} jabatan={ketua.jabatan} featured />}
        </div>

        <div class="flex justify-center">
          <div class="w-px h-8 bg-border"></div>
        </div>

        <div class="relative mx-auto" style="max-width: 90%;">
          <div class="absolute top-0 left-0 right-0 h-px bg-border"></div>
          <div class="flex justify-between px-0">
            {pengurusLain.map(() => (
              <div class="flex flex-col items-center">
                <div class="w-px h-8 bg-border"></div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 max-w-2xl mx-auto animate-on-scroll delay-2">
          {pengurusLain.map((p) => (
            <OrgMemberCard nama={p.nama} jabatan={p.jabatan} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- KONTRIBUTOR -->
  <section class="py-16 md:py-20 bg-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-10 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-text">Kontributor</h2>
        <div class="w-16 h-1 bg-accent-gold mx-auto mt-4"></div>
        <p class="mt-4 text-text-muted">Terima kasih atas dedikasi para kontributor dakwah kami.</p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 animate-on-scroll delay-1">
        {kontributorData.map((nama) => (
          <span class="px-5 py-2.5 bg-bg-alt border border-border rounded-xl text-sm font-medium text-text hover:border-primary/30 hover:bg-primary/5 transition-colors">
            {nama}
          </span>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    headline="Mari Berdakwah,"
    description="Untuk informasi lebih lanjut silahkan hubungi kami,"
    ctaLabel="Hubungi Kami"
    ctaHref="/hubungi-kami"
  />

  <Footer />
</BaseLayout>
